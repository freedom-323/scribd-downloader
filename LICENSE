name: Scribd Downloader

on:
  workflow_dispatch:
    inputs:
      scribd_url:
        description: 'Scribd Document URL'
        required: true
      custom_title:
        description: 'Custom release title (optional, overrides URL/HTML title)'
        required: false
        default: ''

permissions:
  contents: write

jobs:
  archive:
    runs-on: ubuntu-latest

    steps:
      - name: Parse URL and Set Date Fallback
        env:
          RAW_URL: ${{ github.event.inputs.scribd_url }}
          CUSTOM_TITLE: ${{ github.event.inputs.custom_title }}
        run: |
          node -e '
            const fs = require("fs");

            const raw = (process.env.RAW_URL || "").trim();

            // 去掉 #fragment（如 #google_vignette）
            const noHash = raw.split("#")[0];

            const m = noHash.match(/scribd\.com\/document\/(\d+)(?:\/([^\/?#]+))?/i);
            if (!m) {
              console.error("Error: Invalid Scribd URL");
              process.exit(1);
            }

            const docId = m[1];
            const slugRaw = m[2] || "";

            // URL 解码标题段；解码失败则原样保留
            let slugTitle = "";
            if (slugRaw) {
              try { slugTitle = decodeURIComponent(slugRaw); }
              catch (_) { slugTitle = slugRaw; }
              slugTitle = slugTitle.replace(/\+/g, " ").replace(/\s+/g, " ").trim();
            }

            const embedUrl = ["https://scribd.com", "embeds", docId, "content"].join("/");

            const d = new Date();
            const p = n => String(n).padStart(2, "0");
            const dateStr = `${d.getUTCFullYear()}-${p(d.getUTCMonth()+1)}-${p(d.getUTCDate())}`;

            const customTitle = (process.env.CUSTOM_TITLE || "").replace(/\s+/g, " ").trim();
            const outFile = (dateStr + ".html");

            fs.appendFileSync(process.env.GITHUB_ENV,
              `EMBED_URL=${embedUrl}\nCUSTOM_TITLE=${customTitle}\nURL_TITLE=${slugTitle}\nFALLBACK_TITLE=${dateStr}\nOUT_FILE=${outFile}\n`
            );
          '

      - name: Download Single-File HTML
        run: |
          echo "Fetching: $EMBED_URL"
          echo "Output File: $OUT_FILE"

          npx --yes single-file-cli "$EMBED_URL" "$OUT_FILE" \
            --browser-executable-path=/usr/bin/google-chrome \
            --browser-args='["--no-sandbox"]' \
            --load-deferred-images=true

      - name: Resolve Title
        run: |
          node -e '
            const fs = require("fs");

            const html = fs.readFileSync(process.env.OUT_FILE, "utf8");

            const decodeEntities = s => s
              .replace(/&#x([0-9a-f]+);/gi, (_, h) => String.fromCodePoint(parseInt(h, 16)))
              .replace(/&#(\d+);/g, (_, d) => String.fromCodePoint(parseInt(d, 10)))
              .replace(/&amp;/g, "&")
              .replace(/&lt;/g, "<")
              .replace(/&gt;/g, ">")
              .replace(/&quot;/g, "\"")
              .replace(/&apos;/g, "\u0027")
              .replace(/&nbsp;/g, " ");

            const clean = s => decodeEntities(s || "")
              .replace(/[\u200B-\u200D\uFEFF]/g, "")
              .replace(/\s+/g, " ")
              .trim();

            const stripSuffix = t => t.replace(/\s*[-|–—]\s*Scribd\s*$/i, "").trim();

            const fromUrlTitle = () => stripSuffix(clean(process.env.URL_TITLE));

            const fromOgTitle = () => {
              const m = html.match(/<meta[^>]+property=["\x27]og:title["\x27][^>]+content=["\x27]([^"\x27]*)["\x27]/i)
                || html.match(/<meta[^>]+content=["\x27]([^"\x27]*)["\x27][^>]+property=["\x27]og:title["\x27]/i);
              return m ? stripSuffix(clean(m[1])) : "";
            };

            const fromJsonTitle = () => {
              const m = html.match(/"title"\s*:\s*"((?:[^"\\]|\\.)*)"/);
              if (!m) return "";
              try { return stripSuffix(clean(JSON.parse("\"" + m[1] + "\""))); } catch (_) { return ""; }
            };

            const fromH1 = () => {
              const m = html.match(/<h1[^>]*>([\s\S]*?)<\/h1>/i);
              if (!m) return "";
              const text = m[1].replace(/<[^>]+>/g, " ");
              return stripSuffix(clean(text));
            };

            const fromTitleTag = () => {
              const m = html.match(/<title[^>]*>([\s\S]*?)<\/title>/i);
              return m ? stripSuffix(clean(m[1])) : "";
            };

            const candidates = [
              clean(process.env.CUSTOM_TITLE),
              fromUrlTitle(),
              fromOgTitle(),
              fromJsonTitle(),
              fromH1(),
              fromTitleTag(),
              process.env.FALLBACK_TITLE,
            ];

            let title = candidates.find(t => t && !/^scribd$/i.test(t)) || process.env.FALLBACK_TITLE;

            if (title.length > 120) title = title.slice(0, 120).trim();
            title = title.replace(/\.html?$/i, "").trim();
            if (!title) title = process.env.FALLBACK_TITLE;

            const assetName = title
              .replace(/[\/\\:*?"<>|\x00-\x1f]/g, "-")
              .replace(/\s+/g, " ")
              .trim() + ".html";

            fs.appendFileSync(process.env.GITHUB_ENV,
              `DOC_TITLE=${title}\nASSET_FILE=${assetName}\n`
            );
          '

      - name: Create GitHub Release
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          RAW_URL: ${{ github.event.inputs.scribd_url }}
        run: |
          echo "Title: $DOC_TITLE"
          echo "Asset: $ASSET_FILE"

          if [ "$OUT_FILE" != "$ASSET_FILE" ]; then
            mv "$OUT_FILE" "$ASSET_FILE"
          fi

          gh release create "release-${{ github.run_id }}" \
            "$ASSET_FILE" \
            -R "${{ github.repository }}" \
            --title "$DOC_TITLE" \
            --notes "Archived from: ${RAW_URL}"
